<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- 1. Main App Interface (Discovery, Search, Playlists, Offline, Equalizer) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F19" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:visibility="gone"
        android:progressTint="#8B5CF6" />

    <!-- 2. Dedicated In-App Video & Music Player (Top-level WebView: No iframe, No SAMEORIGIN block, 100% sound & clip) -->
    <LinearLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0F19"
        android:visibility="gone">

        <!-- Top Bar -->
        <RelativeLayout
            android:id="@+id/playerTopBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#161B26"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnBackFromPlayer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◀ Geri"
                android:textColor="#A78BFA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingEnd="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/btnBackFromPlayer"
                android:layout_toStartOf="@id/playerActions"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/txtPlayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Müzik Çalınıyor..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtPlayerSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MüzikCepte Dahili Tarayıcı Çalar"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/playerActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDownloadInPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#8B5CF6"
                    android:text="⬇️ İndir"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnPipInPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 PIP"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="6dp" />
            </LinearLayout>
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/playerProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="gone"
            android:progressTint="#EC4899" />

        <WebView
            android:id="@+id/playerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />
    </LinearLayout>

</FrameLayout>
